#!/usr/bin/env bash
set -euo pipefail

GATEWAY_PORT="${UNCHAINED_AGY_PORT:-41415}"
GATEWAY_URL="http://127.0.0.1:${GATEWAY_PORT}"
UNCHAINED_HOME="${UNCHAINED_HOME:-$HOME/.local/lib/codex-unchained}"
GATEWAY_BIN="${UNCHAINED_AGY_GATEWAY_BIN:-$UNCHAINED_HOME/codex-unchained-agy-gateway}"
BROWSER_MCP_BIN="${UNCHAINED_BROWSER_MCP_BIN:-$UNCHAINED_HOME/codex-unchained-browser-mcp}"
CATALOG_PATH="${UNCHAINED_MODEL_CATALOG:-$UNCHAINED_HOME/models.json}"

usage() {
  cat <<'TXT'
Codex Unchained = official Codex CLI with AGY/Ollama brains imported directly.

Usage:
  codex-unchained [normal Codex args...]

Inside Codex:
  /model    Pick directly from discovered AGY + Ollama models.

Optional:
  UNCHAINED_MODEL=agy/gemini-3.8-flash-medium codex-unchained
  codex-unchained -m ollama/qwen3:8b
  codex-unchained doctor
TXT
}

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "Missing required command: $1" >&2; exit 1; }
}

doctor() {
  echo "Codex Unchained doctor"
  echo "----------------------"
  if command -v codex >/dev/null 2>&1; then codex --version; else echo "codex: MISSING"; fi
  if command -v agy >/dev/null 2>&1; then agy --version 2>/dev/null || echo "agy: installed"; else echo "agy: not installed"; fi
  if command -v ollama >/dev/null 2>&1; then ollama --version 2>/dev/null || echo "ollama: installed"; else echo "ollama: not installed"; fi
  [[ -x "$GATEWAY_BIN" ]] && echo "brain gateway: $GATEWAY_BIN" || echo "brain gateway: MISSING at $GATEWAY_BIN"
  [[ -x "$BROWSER_MCP_BIN" ]] && echo "browser MCP: $BROWSER_MCP_BIN" || echo "browser MCP: MISSING at $BROWSER_MCP_BIN"
  [[ -d "$UNCHAINED_HOME/extension" ]] && echo "browser extension: $UNCHAINED_HOME/extension" || echo "browser extension: MISSING"
  [[ -f "$CATALOG_PATH" ]] && echo "last imported model catalog: $CATALOG_PATH" || true
}

if [[ ${1:-} == "doctor" ]]; then doctor; exit 0; fi
if [[ ${1:-} == "--help-unchained" ]]; then usage; exit 0; fi

need codex
need curl
[[ -x "$GATEWAY_BIN" ]] || { echo "Brain gateway not installed: $GATEWAY_BIN" >&2; exit 1; }

mkdir -p "$UNCHAINED_HOME"
started_gateway=0
gateway_pid=""

cleanup() {
  if [[ "$started_gateway" == 1 && -n "$gateway_pid" ]]; then
    kill "$gateway_pid" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT INT TERM

if ! curl -fsS "$GATEWAY_URL/health" >/dev/null 2>&1; then
  "$GATEWAY_BIN" >"$UNCHAINED_HOME/brain-gateway.log" 2>&1 &
  gateway_pid=$!
  started_gateway=1
  for _ in {1..50}; do
    if curl -fsS "$GATEWAY_URL/health" >/dev/null 2>&1; then break; fi
    if ! kill -0 "$gateway_pid" 2>/dev/null; then
      echo "Brain gateway failed to start. See $UNCHAINED_HOME/brain-gateway.log" >&2
      exit 1
    fi
    sleep 0.1
  done
  curl -fsS "$GATEWAY_URL/health" >/dev/null 2>&1 || {
    echo "Brain gateway did not become ready" >&2
    exit 1
  }
fi

tmp_catalog="$CATALOG_PATH.tmp"
if ! curl -fsS "$GATEWAY_URL/v1/models" -o "$tmp_catalog"; then
  rm -f "$tmp_catalog"
  echo "Could not import AGY/Ollama models. Check $UNCHAINED_HOME/brain-gateway.log" >&2
  exit 1
fi
mv "$tmp_catalog" "$CATALOG_PATH"

provider_config="model_providers.unchained={name=\"Codex Unchained\",base_url=\"$GATEWAY_URL/v1\",wire_api=\"responses\",requires_openai_auth=false,supports_websockets=false,supports_standalone_web_search=false}"
catalog_config="model_catalog_json=\"$CATALOG_PATH\""

codex_args=(
  -c 'model_provider="unchained"'
  -c "$provider_config"
  -c "$catalog_config"
)

if [[ -x "$BROWSER_MCP_BIN" ]]; then
  browser_config="mcp_servers.unchained_browser.command=\"$BROWSER_MCP_BIN\""
  codex_args+=(-c "$browser_config")
fi

if [[ -n ${UNCHAINED_MODEL:-} ]]; then
  has_model=0
  for arg in "$@"; do
    if [[ "$arg" == "-m" || "$arg" == "--model" || "$arg" == --model=* ]]; then
      has_model=1
      break
    fi
  done
  if [[ "$has_model" == 0 ]]; then
    codex_args+=(-m "$UNCHAINED_MODEL")
  fi
fi

set +e
codex "${codex_args[@]}" "$@"
status=$?
set -e
exit "$status"
