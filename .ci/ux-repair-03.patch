+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn tool_descriptions_are_human_readable() {
+        assert_eq!(
+            tool_description("browser_navigate", &json!({"url":"https://example.com"})),
+            ("Browser".into(), "navigate https://example.com".into())
+        );
+        assert_eq!(
+            tool_description("fs.write", &json!({"path":"notes.txt"})),
+            ("Write".into(), "notes.txt".into())
+        );
+        assert_eq!(
+            tool_description("shell.run", &json!({"command":"cargo test"})),
+            ("Bash".into(), "cargo test".into())
+        );
+    }
+}
