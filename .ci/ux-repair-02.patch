+pub fn banner(version: &str, project: &std::path::Path) {
+    let rt = runtime();
+    let _guard = rt.write_lock.lock().unwrap_or_else(|e| e.into_inner());
+    let brand = paint(rt, ORANGE, "ADVERTPRENEUR CLI");
+    let ver = paint(rt, MUTED, &format!("v{version} · Rust"));
+    let project_label = paint(rt, MUTED, "Project");
+    let help = if rt.styled {
+        format!(
+            "{} {} {} {} {}",
+            paint(rt, MUTED, "Type"),
+            paint(rt, ORANGE, "/"),
+            paint(rt, MUTED, "commands ·"),
+            paint(rt, PINK, "!"),
+            paint(rt, MUTED, "shell · Ctrl+C stop task")
+        )
+    } else {
+        "Type / commands · ! shell".into()
+    };
+    println!();
+    println!("  {brand}  {ver}");
+    println!("  {project_label}  {}", project.display());
+    println!("  {help}");
+    println!();
+}
