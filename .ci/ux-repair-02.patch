+pub fn prompt(provider: &str, model: &str, browser_connected: bool, resource: &str) -> io::Result<()> {
+    let rt = runtime();
+    let _guard = rt.write_lock.lock().unwrap_or_else(|e| e.into_inner());
+    let provider_text = if model.trim().is_empty() {
+        provider.to_string()
+    } else {
+        format!("{provider}/{model}")
+    };
+    let browser = if browser_connected {
+        paint(rt, GREEN, "browser connected")
+    } else {
+        paint(rt, MUTED, "browser waiting")
+    };
+    let resource = if resource.eq_ignore_ascii_case("green") {
+        paint(rt, GREEN, "GREEN")
+    } else {
+        paint(rt, ORANGE, resource)
+    };
+    println!(
+        "  {} · {} · {}",
+        paint(rt, ORANGE, &provider_text),
+        browser,
+        resource
+    );
+    println!("  {}", paint(rt, MUTED, "╭─ Message Advertpreneur ─"));
+    print!("  {} ", paint(rt, ORANGE, "›"));
+    io::stdout().flush()
+}
