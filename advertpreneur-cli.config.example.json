{
  "default_model": {
    "provider": "cloud",
    "model": "gpt-oss:20b",
    "think": false,
    "max_output_tokens": 4096
  },
  "cloud": {
    "access_mode": "free"
  },
  "budgets": {
    "task_usd": 1.0,
    "daily_usd": 5.0
  },
  "agent": {
    "max_turns": 24,
    "max_tool_output_chars": 10000,
    "approval_mode": "safe"
  },
  "indexing": {
    "auto": true,
    "local_model": "qwen3:1.7b",
    "cloud_policy": "never"
  },
  "context": {
    "auto_compact_tokens": 24000,
    "compact_target_tokens": 9000
  }
}
